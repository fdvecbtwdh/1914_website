# ===== 1914.fun 站点配置 =====
# 复制本文件为 .env 并修改。.env 绝不提交到 Git。

# --- 核心 ---
# 会话签名密钥：用 python -c "import secrets; print(secrets.token_hex(32))" 生成
SESSION_SECRET=change-me-to-a-long-random-string
# 对外访问地址（Cloudflare Tunnel 就绪后）https://1914.fun
SITE_URL=https://1914.fun
SITE_DOMAIN=1914.fun

# --- 数据库 / 上传 ---
DATABASE_URL=sqlite:///D:/Code/1914_website/data/1914.db
UPLOAD_DIR=D:/Code/1914_website/data/uploads
MAX_UPLOAD_MB=4

# --- 游戏项目（官方卡牌导入来源）---
GAME_PROJECT_PATH=D:\Code\1914
GAME_VERSION=0.3.0
GAME_VERSION_LABEL=阶段3 · 15卡+迷雾

# --- HTTPS / Cookie ---
# 生产（Cloudflare Tunnel = HTTPS）保持 1；本地 http 调试可临时设 0
COOKIE_SECURE=1

# --- GitHub Issue 同步（可选；不配置则站点完全不受影响）---
GITHUB_SYNC_ENABLED=1
GITHUB_SYNC_INTERVAL=30
GITHUB_REPO=fdvecbtwdh/1914
# 个人 Settings → Developer settings → Personal access tokens (classic)，
# 勾选 repo 权限即可（站点 Issue → GitHub Issue 单向推送）
GITHUB_TOKEN=
# 网页 Issue 同步目标仓库（与游戏仓库共用 GITHUB_TOKEN）
GITHUB_WEB_REPO=fdvecbtwdh/1914_website

# --- 游戏服务器心跳（状态页 /status 预留接口，可选）---
# 设置后游戏服务端可向 /api/game-server/heartbeat 推送状态；留空 = 功能关闭，状态页显示"不可用"
GAME_SERVER_TOKEN=

# --- 空数据库自动播种（可选，默认开启）---
# 删除数据库后启动会自动：导入官方卡牌 + 默认标签 + 生成初始管理员 admin（随机密码见启动日志）
AUTO_SEED=1

# --- 邮件（账户恢复用；未配置时邮箱恢复功能自动停用）---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@example.com
MAIL_PASSWORD=
MAIL_FROM=noreply@1914.fun
MAIL_USE_TLS=1
# 465 端口的隐式 SSL 用 MAIL_USE_SSL=1（与 TLS 二选一）
MAIL_USE_SSL=0
# 恢复链接有效期（分钟）
RECOVER_TOKEN_MINUTES=30

# --- 服务端口（wsgi.py / cloudflared 使用）---
PORT=8000

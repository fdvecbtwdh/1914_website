# ===== 1914.fun 站点配置 =====
# 复制本文件为 .env 并修改。.env 绝不提交到 Git。

# --- 核心 ---
# 会话签名密钥：python -c "import secrets; print(secrets.token_hex(32))" 生成
SESSION_SECRET=change-me-to-a-long-random-string
# 对外访问地址（Cloudflare Tunnel 就绪后）https://1914.fun
SITE_URL=https://1914.fun
SITE_DOMAIN=1914.fun

# --- 数据库 / 上传 ---
DATABASE_URL=sqlite:///D:/Code/1914_website/data/1914.db
UPLOAD_DIR=D:/Code/1914_website/data/uploads
MAX_UPLOAD_MB=4

# --- 游戏项目（官方卡牌导入来源）---
GAME_PROJECT_PATH=D:\Code914
GAME_VERSION=0.3.0
GAME_VERSION_LABEL=阶段3 · 15卡+迷雾

# --- HTTPS / Cookie ---
# 生产（Cloudflare Tunnel = HTTPS）保持 1；本地 http 调试可临时设 0
COOKIE_SECURE=1

# --- GitHub Issue 同步（可选；不配置则站点完全不受影响）---
GITHUB_SYNC_ENABLED=1
GITHUB_SYNC_INTERVAL=30
# 游戏本体 Issue 的同步目标仓库
GITHUB_REPO=fdvecbtwdh/1914
# 网页 Issue 的同步目标仓库（与游戏仓库共用 GITHUB_TOKEN）
GITHUB_WEB_REPO=fdvecbtwdh/1914_website
# 服务器无法直连 GitHub 时，同步流量走本地代理（Clash 的混合端口）；留空 = 直连
GITHUB_PROXY=http://127.0.0.1:7890
# 个人 Settings → Developer settings → Personal access tokens，
# 权限需覆盖上面两个仓库（classic 勾 repo 即可）
GITHUB_TOKEN=

# --- 游戏服务器心跳（状态页 /status 预留接口，可选）---
# 设置后游戏服务端可向 /api/game-server/heartbeat 推送状态；留空 = 功能关闭，状态页显示"不可用"
GAME_SERVER_TOKEN=

# --- 空数据库自动播种（可选，默认开启）---
# 删除数据库后启动会自动：导入官方卡牌 + 默认标签 + 生成初始管理员 admin（随机密码见启动日志）
AUTO_SEED=1
# 重置默认模板：manage.py save-default 生成 data/default.db；
# 库文件缺失时若存在该模板则整库恢复（优先于播种）。留空 = 使用默认路径
DB_TEMPLATE_PATH=

# --- 邮件（账户恢复用；未配置 MAIL_HOST 时邮箱恢复功能自动停用）---
# 示例为 Brevo 中继；QQ/163 等见下注释
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# Login：Brevo 后台 SMTP & API 页面的登录名
MAIL_USER=your-login@smtp-brevo.com
# 密钥：Brevo 的 SMTP key（不是 Brevo 登录密码）
MAIL_PASSWORD=
# 发件人：必须是 Brevo 后台 Senders 里已验证的邮箱
MAIL_FROM=you@your-domain.com
# 587 端口 STARTTLS：MAIL_USE_TLS=1；465 端口隐式 SSL：改用 MAIL_USE_SSL=1
MAIL_USE_TLS=1
MAIL_USE_SSL=0
# 恢复链接有效期（分钟）
RECOVER_TOKEN_MINUTES=30

# --- 状态页采样线程（可选；测试/排错时可设 0）---
STATUS_SAMPLER_ENABLED=1

# --- QQ 邮箱示例（替换上方 MAIL_HOST/USER/PASSWORD/FROM）---
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=587
# MAIL_USER=你的QQ号@qq.com
# MAIL_PASSWORD=16位授权码（设置→账户→开启SMTP后获取，不是QQ密码）
# MAIL_FROM=你的QQ号@qq.com

# --- 服务端口（wsgi.py / cloudflared 使用）---
PORT=8000
